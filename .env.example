# Copy this file to `.env` and fill in your own keys. NEVER commit `.env`.

# Groq (free tier) - Whisper transcription: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier) - planning: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - image sourcing via Unsplash: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Root folder for temp media (audio, B-roll, renders). Created at runtime and purged after render.
# Local Windows example: D:\vibecrop_tmp
# Google Colab example:  /content/vibecrop_work
VIBECROP_WORKDIR=D:\vibecrop_tmp

# Optional overrides
# WHISPER_MODEL=whisper-large-v3-turbo
# MAX_VIDEO_SECONDS=180
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite   (comma-separated; used if the main model is overloaded)
# TOTAL_BROLLS=10   # default B-roll count, 1-15
# ENABLE_IMAGES=1   (images are off by default; the MVP is video-only for now)
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite   (the chat assistant's model; the light one answers in ~3 s per step.
#                                            gemini-3.5-flash is smarter but takes 10-20 s per step)
